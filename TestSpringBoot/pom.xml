<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.msb</groupId>
        <artifactId>JavaProject</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>TestSpringBoot</artifactId>

    <properties>
        <!-- Spring Boot 全家桶统一版本，所有 spring-boot-* 构件以此对齐，杜绝版本混用 -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- MyBatis Starter 官方要求：4.1.0 对应 Spring Boot 4.1 -->
        <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
    </properties>

    <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot -->
    <dependencies>
        <!--     springboot 全家桶依赖库-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring-boot.version}</version>
            <scope>compile</scope>
        </dependency>

        <!--    springboot Tomcat启动器-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
            <scope>compile</scope>
        </dependency>

        <!--    springBoot 数据库mapper -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
            <scope>compile</scope>
        </dependency>
        <!--    数据库驱动-jdbc（旧坐标 mysql:mysql-connector-java 已 relocation 到 com.mysql:mysql-connector-j）-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.7.0</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>


</project>
