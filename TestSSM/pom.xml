<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.msb</groupId>
        <artifactId>JavaProject</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>TestSSM</artifactId>
    <packaging>war</packaging>

<!--maven很智能 重复的导包会置灰-->
    <dependencies>
        <!--    1 数据库驱动-jdbc-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>compile</scope>
        </dependency>
        <!--    2 数据连接层-mybatis-->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.5.19</version>
            <scope>compile</scope>
        </dependency>
        <!--    3 日志：log4j mybatisSql执行日志打印-->
        <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
            <version>1.2.17</version>
            <scope>compile</scope>
        </dependency>
        <!--    4 spring 依赖注入包
             注意：spring-context 必须与 spring-webmvc / spring-jdbc 版本严格一致。
             混用会导致 Spring 7(基于 Jakarta) 的 spring-context 与 Spring 5.3 的 spring-webmvc
             出现 NoClassDefFoundError: org/springframework/ui/context/ThemeSource
             (该类只存在于 spring-context 5.x/6.x，7.x 已移除)。
             这里统一到 5.3.16(javax.servlet 基线)，与 web.xml 的 Servlet 4.0、Tomcat 9 一致。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>compile</scope>
        </dependency>
        <!--        5 Spring jdbc依赖-->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <!-- 6 spring整合mybatis的依赖 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>2.0.7</version>
        </dependency>
        <!-- 7 依赖了Spring框架核心功能的5个依赖以及Spring整合Web的依赖spring-web -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <!-- 8 Servlet API 由容器(Tomcat 9)提供，编译期需要，打包时不进 war -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- Spring 全家桶统一版本，禁止单独升级其中某一个模块 -->
        <spring.version>5.3.16</spring.version>
    </properties>

    <!--    tomcat plugin-->
    <build>
        <plugins>
            <!-- Tomcat插件
                 原 tomcat7-maven-plugin:2.2 绑定的是 Tomcat 7.0.47(2013年版本)：
                   1) 其内嵌 BCEL 不认识 Java 9+ 的 module-info.class，会抛
                      "Invalid byte tag in constant pool: 19"；
                   2) Tomcat 7 基于 Servlet 3.0，无法承载 Spring 5.3 所需的 Servlet 4.0；
                   3) 官方已停止维护，不支持 JDK 17。
                 改用 tomcat9-maven-plugin(基于官方 tomcat-maven-plugin 的活跃分支)，
                 绑定 Tomcat 9.0.56 —— javax.servlet 4.0 基线 + 官方支持 JDK 17。
                 注意：Tomcat 9.0.56 满足 Spring 5.3 的最低要求；如需更新版本，
                 升级 tomcat9-maven-plugin 版本即可(其内置 tomcat9Version 随之升级)。 -->
            <plugin>
                <groupId>org.opoo.maven</groupId>
                <artifactId>tomcat9-maven-plugin</artifactId>
                <version>3.0.1</version>
                <configuration>
                    <path>/t</path><!--指定项目的上下文路径-->
                    <port>8080</port><!-- 端口-->
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
